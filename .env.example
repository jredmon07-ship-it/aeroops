# AeroOps — environment contract. Copy to .env.local and fill in. NEVER commit real keys.

# --- Database (Postgres: Neon / Supabase) ---
DATABASE_URL="postgresql://user:password@host:5432/aeroops?sslmode=require"
# Optional read-replica for the Reporting Hub
DATABASE_REPLICA_URL=""

# --- Auth (Auth.js) ---
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# --- Stripe (payments + Connect for multi-tenant payouts) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID="ca_..."

# --- QuickBooks Online ---
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:3000/api/integrations/qbo/callback"
QBO_ENVIRONMENT="sandbox"

# --- Weather (AWC METAR/TAF) + civil twilight ---
AWC_API_BASE="https://aviationweather.gov/api"

# --- Notifications: email / SMS / push ---
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
EXPO_PUSH_ACCESS_TOKEN=""

# --- AI runtime (in-product agents, §7 of THE-BIBLE.md) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- File storage ---
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- App ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
