{
  "name": "@aeroops/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations, and Row-Level-Security policies (Postgres).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node scripts/migrate.mjs",
    "migrate:apply": "node scripts/migrate.mjs --apply",
    "purge:booking": "node scripts/purge-booking-requests.mjs",
    "purge:booking:apply": "node scripts/purge-booking-requests.mjs --apply",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(db) no lint configured yet\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@aeroops/core": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@types/node": "^25.9.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
