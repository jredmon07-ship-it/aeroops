# AeroOps database connection string.
# Copy this file to .env and fill in your actual values.
# NEVER commit a real .env file with connection credentials.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# For local dev:   postgresql://postgres:postgres@localhost:5432/aeroops_dev
# For Neon/Supabase: use the connection string from the dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
