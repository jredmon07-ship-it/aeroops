{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@aeroops/core": ["../core/src/index.ts"],
      "@aeroops/core/*": ["../core/src/*"],
      "@aeroops/db": ["../db/src/index.ts"],
      "@aeroops/db/*": ["../db/src/*"],
      "@aeroops/api": ["./src/index.ts"],
      "@aeroops/api/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["dist", "node_modules"]
}
