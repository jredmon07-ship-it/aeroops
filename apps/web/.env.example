# ─── AeroOps Web App — Required Environment Variables ─────────────────────────
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit real secrets.
#
# Generate AUTH_SECRET with:
#   openssl rand -base64 32

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Required: must be a securely-random string, at least 32 characters.
# buildAuthConfig() throws at startup if this is unset.
AUTH_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────
# Required at runtime (not at build time). Postgres connection string.
# Used by getDb() inside @aeroops/api. Set in .env.local for local dev.
# Example: postgresql://user:password@localhost:5432/aeroops
DATABASE_URL=

# ─── Next.js ──────────────────────────────────────────────────────────────────
# Optional: Override the default Next.js URL for Auth.js callbacks.
# Required in production behind a reverse proxy.
# NEXTAUTH_URL=https://your-domain.com
